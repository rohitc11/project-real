# Copy to .env.local and fill in. Never commit .env.local.

# Email delivery for the contact form (https://resend.com).
# Without this the form logs enquiries to the console in development and
# refuses to submit in production, so leads are never silently dropped.
RESEND_API_KEY=

# Optional. Defaults to BRAND.email.general from src/config/brand.ts.
CONTACT_TO_EMAIL=

# Optional. Must be a sender verified in Resend.
# Defaults to the Resend sandbox sender, which only delivers to your own address.
CONTACT_FROM_EMAIL=

# Canonical site origin, used for metadata, sitemap.xml, robots.txt and JSON-LD.
# Leave empty on Vercel and the production deployment URL is used automatically.
# Set it once a real domain is attached, e.g. https://keyturnmedia.com
NEXT_PUBLIC_SITE_URL=
