# Public URL of the site, used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form → email via Resend (https://resend.com).
RESEND_API_KEY=
# Where enquiries go (comma-separated for several inboxes).
CONTACT_TO=
# A sender on a domain verified in Resend, e.g. "Website <website@your-domain.com>".
CONTACT_FROM=
